# Living-Ora-Apartment-Sales-System .gitignore

# Sensitive files & API Keys / Credentials
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*secret*
*password*
*credentials*
*.key
*.pem
id_rsa*

# Exclude DB folder per user instruction
Apartment Sales System DB/

# IDE & Editor files
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# Frontend ignore
Apartment Sales System Frontend/node_modules/
Apartment Sales System Frontend/dist/
Apartment Sales System Frontend/.vite/
Apartment Sales System Frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend & Gradle ignore
.gradle-user/
.gradle/
**/build/
**/bin/
**/out/
!gradle/wrapper/gradle-wrapper.jar
